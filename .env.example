# Copy this file to .env and fill in your free API keys.
# .env is git-ignored and MUST NOT be committed.

# VirusTotal (https://www.virustotal.com) — hash/URL/domain reputation
VT_API_KEY=

# AbuseIPDB (https://www.abuseipdb.com) — sender IP reputation
ABUSEIPDB_API_KEY=

# URLhaus / abuse.ch (https://urlhaus.abuse.ch) — Auth-Key header
URLHAUS_KEY=

# Where SIEM (Wazuh) alert lines are written. On Windows the default below is
# used instead; override here if you run a local Wazuh agent on Linux.
PHISHGUARD_SIEM_LOG=/var/log/phishguard/alerts.json
